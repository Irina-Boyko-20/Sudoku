<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>
<?import javafx.geometry.Insets?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" prefHeight="700.0" prefWidth="650.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="sudoku.SudokuController">
   <top>
      <HBox prefHeight="100.0" prefWidth="200.0" spacing="10.0" BorderPane.alignment="CENTER">
         <children>
            <Label alignment="CENTER" prefHeight="60.0" prefWidth="200.0" text="Sudoku" textAlignment="CENTER">
               <font>
                  <Font size="48.0" />
               </font></Label>
            <ComboBox fx:id="levelComboBox" prefHeight="43.0" prefWidth="150.0" promptText="Level" />
            <Button fx:id="newGameButton" mnemonicParsing="false" onAction="#handleNewGame" prefHeight="40.0" prefWidth="100.0" text="New game" />
         </children>
      </HBox>
   </top>
   <center>
      <GridPane fx:id="gridPane" prefHeight="450.0" prefWidth="450.0" BorderPane.alignment="CENTER" />
   </center>
   <bottom>
      <HBox fx:id="buttonPanel" alignment="CENTER" spacing="10.0" >
        <BorderPane.margin>
            <Insets bottom="50.0" />
        </BorderPane.margin>
      </HBox>
   </bottom>
</BorderPane>
